<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cherrypick</AssemblyName>
    <RootNamespace>CherryPick</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No apphost: the produced exe would be an unsigned binary, which Smart App
         Control blocks. We go through dotnet.exe, signed by Microsoft, which loads
         the DLL. Never disable Smart App Control to work around this: under
         Windows 11 it cannot be turned back on without reinstalling the system. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

</Project>
