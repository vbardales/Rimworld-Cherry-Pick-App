<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cherrypick</AssemblyName>
    <RootNamespace>CherryPick</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Pas d'apphost : l'exe produit serait un binaire non signe, que Smart App
         Control bloque. On passe par dotnet.exe, signe par Microsoft, qui charge
         la DLL. Ne jamais desactiver Smart App Control pour contourner : sous
         Windows 11 on ne peut plus le reactiver sans reinstaller le systeme. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

</Project>
